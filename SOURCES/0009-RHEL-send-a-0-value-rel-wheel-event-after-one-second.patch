 	Bool (*ParseOptions)(WacomDevicePtr priv); /* parse class-specific options */
 	Bool (*Init)(WacomDevicePtr priv);   /* initialize device */
+	void (*Free)(void *private);         /* free device */
 };
 
 extern WacomHWClass *WacomGetClassUSB(void);
